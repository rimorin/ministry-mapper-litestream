# R2 Credentials (set these in Coolify UI — never commit real values)
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com

# The following are hardcoded per environment in docker-compose.{env}.yml
# and do NOT need to be set as env vars in Coolify:
#
#   R2_BUCKET=mm-pb-backups
#   R2_PATH=dev|staging|production
#   SYNC_INTERVAL=300s|60s|10s
#   SNAPSHOT_RETENTION=24h|72h|168h

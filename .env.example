# R2 Credentials
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_ENDPOINT=<account_id>.r2.cloudflarestorage.com

# R2 Bucket
R2_BUCKET=mm-pb-backups
R2_PATH=                    # staging or production

# Host path to SQLite data directory
DATA_PATH=                  # /data/staging or /data/production

# Sync interval (10s for production, 60s for staging)
SYNC_INTERVAL=10s
